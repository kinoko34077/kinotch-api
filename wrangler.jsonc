{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "account_id": "fb59b3c4a3fb2cda44dad80638390309",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    { "binding": "CLOCK_SERVER", "service": "clock-server" },
    { "binding": "WEATHER_PROXY", "service": "weather-proxy" },
    { "binding": "ROKUYO_PROXY", "service": "rokuyo-proxy" },
    { "binding": "TEXT_TRANSFORM", "service": "text-transform" },
    { "binding": "COMPRESSION", "service": "semantic-compression" }
  ],
  "ratelimits": [
    {
      "name": "GENERAL_RATE_LIMITER",
      "namespace_id": "26090801",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "TEXT_RATE_LIMITER",
      "namespace_id": "26090802",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "COMPRESSION_RATE_LIMITER",
      "namespace_id": "26090803",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ENABLE_REQUEST_LOGS": "true"
  },
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
