{
  "schema_version": 1,
  "project": {
    "name": "kinotch-api",
    "type": "cloudflare-api",
    "description": "Hono and Cloudflare Workers API gateway with text transformation and MCP surfaces."
  },
  "profile": "api",
  "profiles": [
    "api",
    "mcp"
  ],
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": false,
    "gui_windows": false,
    "web": false,
    "api": true,
    "mcp": true,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": {
      "exec": "npm",
      "args": ["ci"],
      "cwd": ".",
      "forward_args": false
    },
    "dev": {
      "exec": "npm",
      "args": ["run", "dev"],
      "cwd": ".",
      "forward_args": false
    },
    "test": {
      "exec": "npm",
      "args": ["test"],
      "cwd": ".",
      "forward_args": false
    },
    "build": "",
    "verify": "",
    "smoke": "",
    "deploy": {
      "exec": "npm",
      "args": ["run", "deploy"],
      "cwd": ".",
      "forward_args": false
    }
  },
  "paths": {
    "docs": "../docs/",
    "source": "../src/",
    "tests": "../test/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "This adoption adds the KiNoTch Base and Project Overlay without moving Worker or Domain files.",
    "HTTP status, public error codes, bindings, generated snapshots, and deployment remain Project-owned.",
    "MCP behavior is declared as a Surface; no Runtime Action Registry is introduced."
  ]
}
