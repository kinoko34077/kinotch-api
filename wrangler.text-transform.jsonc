{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-transform",
  "account_id": "fb59b3c4a3fb2cda44dad80638390309",
  "main": "src/text-transform-worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "src/text-core/dict",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
