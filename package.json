{
  "name": "kinotch-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:text-rules": "node scripts/build-text-rules.mjs",
    "build:text-metadata": "node scripts/build-text-metadata.mjs",
    "build:text-client": "node scripts/build-text-client.mjs",
    "build:kanji-fallback": "node scripts/build-kanji-fallback.mjs",
    "build:browser-client": "node scripts/build-browser-client.mjs",
    "build:text-snapshot": "npm run build:text-rules && npm run build:text-metadata && npm run build:text-client && npm run build:kanji-fallback && npm run build:browser-client",
    "dev:text-transform": "npm run build:text-snapshot && wrangler dev --config wrangler.text-transform.jsonc",
    "dev:compression-mcp": "wrangler dev --config wrangler.semantic-compression-mcp.jsonc",
    "dev:jev-audit": "wrangler dev --config wrangler.jev-audit.jsonc",
    "dev:jev-audit-mcp": "wrangler dev --config wrangler.jev-audit-mcp.jsonc",
    "benchmark:text-transform": "node scripts/benchmark-text-transform.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:jev-audit": "node scripts/smoke-jev-audit.mjs",
    "smoke:mcp:local": "node scripts/production-secret-mapper.mjs mcp-smoke",
    "release:local": "node scripts/production-secret-mapper.mjs production-release",
    "bootstrap:mcp": "node scripts/mcp-bootstrap.mjs",
    "bootstrap:jev-audit": "node scripts/jev-audit-bootstrap.mjs",
    "bootstrap:jev-audit:local": "node scripts/production-secret-mapper.mjs jev-audit-bootstrap",
    "test:compression:live": "node --test test/semantic-compression-live.test.js",
    "test:mcp": "node --test test/semantic-compression-mcp-*.test.js",
    "evaluate:compression": "node scripts/evaluate-compression.mjs",
    "measure:compression:usage": "node scripts/measure-compression-usage.mjs",
    "measure:compression:prompt-tokens": "node scripts/measure-compression-prompt-tokens.mjs",
    "deploy:production": "node scripts/deploy-production-with-jev-audit.mjs",
    "check:text-rules": "node scripts/check-text-rules.mjs",
    "check:text-metadata": "node scripts/check-text-metadata.mjs",
    "check:text-client": "node scripts/check-text-client.mjs",
    "check:kanji-fallback": "node scripts/check-kanji-fallback.mjs",
    "check:browser-client": "node scripts/check-browser-client.mjs",
    "check:text-snapshot": "npm run check:text-rules && npm run check:text-metadata && npm run check:text-client && npm run check:kanji-fallback && npm run check:browser-client",
    "pretest": "npm run check:text-snapshot",
    "test": "node --test test/*.test.js",
    "deploy": "npm run deploy:production"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "hono": "^4.9.7",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "json5": "^2.2.3",
    "wrangler": "4.131.1"
  }
}
